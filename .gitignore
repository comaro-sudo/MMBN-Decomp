# ============================================================
# MMBN-Decomp (Mega Man Battle Network decomp collection) — .gitignore
# Rule #1: never commit Capcom ROMs or anything built from them.
# Rule #2: never commit third-party guides, maps or other people's assets.
# Each game lives in its own folder (MMBN4-Decomp/, ...): "/*/" below
# means "inside any game folder".
# ============================================================

# --- Original ROMs (keep each game's roms/ folder + README, ignore the contents) ---
/*/roms/*
!/*/roms/README.md
*.gba
*.agb
*.mb
*.nds
*.dsi
*.3ds
*.cia
*.cxi
*.srl
*.zip
*.7z
*.rar

# --- Build output (patched ROMs, patches, intermediates) ---
# build/ at any depth: <game>/build/ (patch, ports, libmgba) and <game>/decomp/build/.
build/
*.bps
*.ips
*.ups
*.xdelta
*.sym
*.elf
*.o
*.map

# --- Third-party tools and cloned reference repos (repo root or a game
#     folder; <game>/decomp/tools/ holds our own scripts and IS tracked) ---
/tools/
/ext/
/*/tools/
/*/ext/

# --- Third-party reference material (guides, fan maps); see <game>/ref/README.md ---
/*/ref/*
!/*/ref/README.md

# --- Extracted / dumped game data (copyrighted; regenerate from your ROM) ---
# TextPet dumps are tracked ONLY after editing, under <game>/patch/src/scripts/.
extracted/
dump/
dumps/
*.dump
*.dmp
# RAM dumps from the PC port's --dump (docs/re/) and TextPet script extractions
*.ewram
*.iwram
*.tpl
!/*/patch/src/scripts/**/*.tpl

# --- Emulator saves, states, recordings ---
# Save states hold RAM/VRAM snapshots, so keep them local.
*.ss[0-9]
*.ss
*.state
*.state[0-9]
*.st[0-9]
*.sgm
*.mgm
*.vbm
# Cheat-device and emulator save exports (GameShark SP / SharkPort, Action Replay, VBA)
*.sps
*.xps
*.gsv
*.duc
*.dsv
# Raw saves ignored everywhere except the curated test library.
*.sav
*.srm
*.fla
!/*/test/saves/*.sav
!/*/test/saves/*.srm
# No$GBA writes saves into BATTERY/
BATTERY/

# --- Debugger / RE workspaces ---
# Keep Ghidra projects under a ghidra/ folder so they're ignored as a whole.
ghidra/
*.gpr
*.rep/
*.no$gba

# --- Ports (CMake / MSVC / devkitPro / clangd) ---
out/
cmake-build-*/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
.cache/
.vs/
*.vcxproj.user
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.exp
*.obj
# console outputs (Wii U, 3DS, DS)
*.wuhb
*.rpx
*.rpl
*.3dsx
*.smdh
*.dol

# --- Decomp: generated diagnostics (regenerate with decomp/tools) ---
/*/decomp/symbols/prologue_candidates_*.txt

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Logs & temp ---
*.log
*.tmp
*.bak

# --- Editors & OS ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# --- Local notes / secrets ---
.claude/settings.local.json
.env
*.local.md
