# ============================================================
# MMBN4 Overhaul — .gitignore
# Rule #1: never commit Capcom ROMs or anything built from them.
# ============================================================

# --- Original ROMs (keep the folder + README, ignore the contents) ---
roms/*
!roms/README.md
*.gba
*.agb
*.mb
*.nds
*.dsi
*.3ds
*.cia
*.cxi
*.srl
*.zip
*.7z
*.rar

# --- Build output (patched ROMs, patches, intermediates) ---
build/
*.bps
*.ips
*.ups
*.xdelta
*.sym
*.elf
*.o
*.map

# --- Third-party tools and cloned reference repos (repo root only;
#     decomp/tools/ holds our own scripts and IS tracked) ---
/tools/
/ext/

# --- Extracted / dumped game data (copyrighted; regenerate from your ROM) ---
# TextPet dumps are tracked ONLY after editing, under src/scripts/.
extracted/
dump/
dumps/
*.dump
*.dmp

# --- Emulator saves, states, recordings ---
# Save states hold RAM/VRAM snapshots, so keep them local.
*.ss[0-9]
*.ss
*.state
*.st[0-9]
*.sgm
*.mgm
*.vbm
# Raw saves ignored everywhere except the curated test library.
*.sav
*.srm
*.fla
!test/saves/*.sav
!test/saves/*.srm
# No$GBA writes saves into BATTERY/
BATTERY/

# --- Debugger / RE workspaces ---
# Keep Ghidra projects under ghidra/ (repo root) so they're ignored as a whole.
ghidra/
*.gpr
*.rep/
*.no$gba

# --- Future native ports (CMake / devkitPro / MSVC / clangd) ---
out/
cmake-build-*/
CMakeUserPresets.json
.cache/
.vs/
*.vcxproj.user
*.pdb
*.ilk
*.exe
*.dll

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Logs & temp ---
*.log
*.tmp
*.bak

# --- Editors & OS ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# --- Local notes / secrets ---
.claude/settings.local.json
.env
*.local.md
